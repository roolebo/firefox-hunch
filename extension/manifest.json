{
  "manifest_version": 2,
  "name": "hunch",
  "version": "0.1",
  "description": "Lets an agent read the page the human works on through hunch.",
  "permissions": ["tabs", "storage", "<all_urls>"],
  "background": {
    "scripts": ["background.js"]
  },
  "options_ui": {
    "page": "options.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "firefox-hunch@hunch"
    }
  }
}
